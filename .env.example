# Everblock server settings. Copy to .env and edit:   cp .env.example .env
# (docker compose and `npm start` both read this file; restart after changes)

# Your domain name for automatic HTTPS, e.g. play.example.com (needs a DNS A record pointing at this server).
# No domain? Use <your-ip>.sslip.io (e.g. 203-0-113-7.sslip.io) for free HTTPS, or leave empty for plain http://<ip>
DOMAIN=

# Shown on the start screen and in /who
SERVER_NAME=Everblock
MOTD=Welcome! Type /help for commands, /ooc to chat with everyone, /invite to group.

# Comma-separated account names that get admin (/kick /ban /announce /tp ...). The first account ever registered is admin too.
ADMINS=

# 1 = anyone can create an account, 0 = closed (create accounts with: docker compose exec everblock node admin.js ...)
ALLOW_REGISTER=1
# 1 = players can place/break blocks (shared and saved for everyone), 0 = world edits off
ALLOW_BUILD=1

# Limits (defaults are deliberately light; raise them on a bigger server)
MAX_PLAYERS=200
MAX_CONN_PER_IP=8

# World seed for a fresh world (number or text). Changing it later regenerates terrain but keeps saved block edits.
WORLD_SEED=1999

# Port the game server listens on. With docker compose, Caddy talks to it internally;
# set BIND_ADDR=0.0.0.0 to also expose it directly on this port (e.g. without Caddy).
PORT=8080
BIND_ADDR=127.0.0.1

# Behind a reverse proxy (Caddy/nginx) set 1 so per-IP limits see real client addresses. docker compose sets this for you.
TRUST_PROXY=0
